    {
      "type": "text",
      "id": "evidence_t",
      "x": 52,
      "y": 952,
      "width": 816,
      "height": 64,
      "text": "metadata: { event_type: review_notification, review_record_id }\nclaimForDelivery: pending OR (delivering AND claimedAt > 5m)  ·  SKIP LOCKED\nSlack + Postgres cannot commit together. That is why the hop exists.",
      "originalText": "metadata: { event_type: review_notification, review_record_id }\nclaimForDelivery: pending OR (delivering AND claimedAt > 5m)  ·  SKIP LOCKED\nSlack + Postgres cannot commit together. That is why the hop exists.",
