      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 3,
      "text": "Chat can steer — latest @ wins.\nA push never steers:\nit never becomes a turn.",
      "originalText": "Chat can steer — latest @ wins.\nA push never steers:\nit never becomes a turn.",
