      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 3,
      "text": "Injection is a first-token problem,\nnot a tool-choice problem.",
      "originalText": "Injection is a first-token problem,\nnot a tool-choice problem.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 14,
      "autoResize": true
    },
