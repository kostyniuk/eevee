    {
      "id": "e009",
      "type": "text",
      "x": 990,
      "y": 378,
      "width": 352.59999999999997,
      "height": 220.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
