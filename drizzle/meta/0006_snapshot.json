        "review_records_safety_rating_check": {
          "name": "review_records_safety_rating_check",
          "value": "\"review_records\".\"safety_rating\" between 0 and 5"
        },
        "review_records_criteria_object_check": {
          "name": "review_records_criteria_object_check",
          "value": "jsonb_typeof(\"review_records\".\"criteria\") = 'object'"
        },
        "review_records_security_criterion_check": {
          "name": "review_records_security_criterion_check",
          "value": "\n    coalesce(jsonb_typeof(\"review_records\".\"criteria\" #> '{security}') = 'object', false)\n    and case\n      when jsonb_typeof(\"review_records\".\"criteria\" #> '{security,rating}') = 'number'\n      then (\"review_records\".\"criteria\" #>> '{security,rating}')::numeric between 0 and 5\n        and (\"review_records\".\"criteria\" #>> '{security,rating}')::numeric = trunc((\"review_records\".\"criteria\" #>> '{security,rating}')::numeric)\n      else false\n    end\n    and coalesce(jsonb_typeof(\"review_records\".\"criteria\" #> '{security,reasoning}') = 'string', false)\n  "
        },
        "review_records_blast_radius_criterion_check": {
